# 로컬 개발 + 로컬 스크립트용. 배포용은 deploy/.env.example.

OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333
FSS_API_KEY=

# 객체 스토리지 (로컬은 minio, 배포는 s3)
STORAGE_BACKEND=minio
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=product-clauses

# scripts/storage/migrate_minio_to_s3.py 전용. s3:PutObject 권한 필요.
S3_BUCKET_NAME=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
