# OpenAI (임베딩: text-embedding-3-large)
OPENAI_API_KEY=

# Anthropic Claude (LLM: claude-opus-4-8)
ANTHROPIC_API_KEY=

# Qdrant (docker-compose로 로컬 기동 시 기본값)
QDRANT_URL=http://localhost:6333

# 객체 스토리지: 로컬은 minio (docker-compose로 로컬 기동 시 기본값, S3 호환 API).
# 배포(deploy/.env)는 STORAGE_BACKEND=s3 + AWS_REGION/S3_BUCKET_NAME을 쓴다.
STORAGE_BACKEND=minio
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=product-clauses

# 금융감독원 Open API key
FSS_API_KEY=