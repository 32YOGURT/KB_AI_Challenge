# deploy/docker-compose.yml 전용 .env. 이 파일 옆에 .env로 복사해서 채운다.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FSS_API_KEY=

QDRANT_API_KEY=

# 객체 스토리지: 배포는 실제 AWS S3.
STORAGE_BACKEND=s3
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
# 자격증명은 가능하면 인스턴스에 붙인 IAM 롤로 해결하고, 그게 안 되면 아래 두 개를 채운다
# (boto3 기본 자격증명 체인이 자동으로 읽는다 — 앱 코드가 직접 읽지 않음).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 프론트 배포 도메인(들). 쉼표로 여러 개 가능. 예: https://finguard.example.com
ALLOWED_ORIGINS=

# 브라우저가 접근할 백엔드 공개 URL. next build 시점에 클라이언트 번들에 박히므로
# 배포 후 바꾸려면 프론트를 재빌드해야 한다. 예: https://api.finguard.example.com
NEXT_PUBLIC_API_BASE_URL=
