# deploy/docker-compose.yml 전용 .env. 이 파일 옆에 .env로 복사해서 채운다.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FSS_API_KEY=

QDRANT_API_KEY=

# 객체 스토리지: 배포는 실제 AWS S3.
STORAGE_BACKEND=s3
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
# 자격증명은 가능하면 인스턴스에 붙인 IAM 롤로 해결하고, 그게 안 되면 아래 두 개를 채운다
# (boto3 기본 자격증명 체인이 자동으로 읽는다 — 앱 코드가 직접 읽지 않음).
# EC2 런타임에 필요한 권한은 s3:GetObject 하나뿐이다(presign이 head_object로 존재만 확인하고,
# 발급된 URL은 이 자격증명의 권한을 물려받는다). 업로드는 로컬에서만 하므로 s3:PutObject 불필요.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 서비스 도메인. 이 서버 공인 IP를 가리키고 있어야 Caddy가 인증서를 발급받는다.
# 예: finguard.duckdns.org
DOMAIN=

# 브라우저가 접근할 백엔드 공개 URL. Caddy가 /api/*를 백엔드로 넘기므로 DOMAIN과 같은
# origin을 쓴다. next build 시점에 클라이언트 번들에 박히므로 바꾸려면 프론트 재빌드 필요.
# 예: https://finguard.duckdns.org
NEXT_PUBLIC_API_BASE_URL=

# 프론트와 백엔드가 같은 origin이라 CORS가 필요 없다 — 비워두면 된다.
# 다른 도메인에서 API를 직접 부를 일이 생기면 그때만 쉼표로 나열한다.
ALLOWED_ORIGINS=
