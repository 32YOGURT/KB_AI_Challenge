# deploy/docker-compose.yml 전용. 이 파일 옆에 .env로 복사해서 채운다.

OPENAI_API_KEY=
FSS_API_KEY=

# Qdrant 컨테이너 인증키 + 백엔드가 실어보낼 키(같은 값). 예: openssl rand -hex 32
QDRANT_API_KEY=

# 객체 스토리지: 배포는 실제 AWS S3.
STORAGE_BACKEND=s3
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
# IAM 롤이 있으면 비워둔다(boto3 기본 체인이 읽음). 런타임엔 s3:GetObject만 있으면 된다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 서비스 도메인. EC2 공인 IP를 가리켜야 Caddy가 인증서를 발급받는다. 예: finguard.duckdns.org
DOMAIN=

# 브라우저가 쓸 백엔드 URL. DOMAIN과 같은 origin. next build 시점에 박히므로 바꾸면 재빌드.
NEXT_PUBLIC_API_BASE_URL=

# 프론트/백엔드가 같은 origin이라 보통 비워둔다.
ALLOWED_ORIGINS=
